{
    "i18n": true,
    "type": "panel",
    "items": {
        "_logo": {
            "type": "staticImage",
            "src": "pimatic.png",
            "style": {
                "width": "64px"
            },
            "sm": 12,
            "md": 2,
            "lg": 1
        },
        "host": {
            "type": "text",
            "label": "IP address",
            "validator": "!!data.host",
            "validatorErrorText": "Please enter the address of your pimatic server",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "sm": 12,
            "md": 6,
            "lg": 4
        },
        "port": {
            "type": "number",
            "label": "Port",
            "min": 1,
            "max": 65535,
            "sm": 12,
            "md": 3,
            "lg": 2
        },
        "username": {
            "type": "text",
            "label": "Username",
            "newLine": true,
            "sm": 12,
            "md": 6,
            "lg": 4
        },
        "enc_password": {
            "type": "password",
            "label": "Password",
            "sm": 12,
            "md": 6,
            "lg": 4
        }
    }
}
